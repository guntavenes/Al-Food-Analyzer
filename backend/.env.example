PORT=8080
NODE_ENV=development
FOOD_ANALYSIS_PROVIDER=mock
MAX_IMAGE_SIZE_MB=8
MOCK_ANALYSIS_DELAY_MS=1200
MOCK_ANALYSIS_FORCE_ERROR=false
MOCK_ANALYSIS_NO_FOOD=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT_MS=30000
OPENAI_MAX_RETRIES=1
OPENAI_REASONING_EFFORT=low
OPENAI_IMAGE_DETAIL=low
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30
ANALYSIS_RATE_LIMIT_WINDOW_MS=3600000
ANALYSIS_RATE_LIMIT_MAX_REQUESTS=10
AUTH_REQUIRED=false
SUPABASE_URL=
SUPABASE_SERVER_KEY_V2=
APPLE_IAP_ENABLED=false
APPLE_BUNDLE_ID=com.enesguntav.aiFoodAnalyzer
APPLE_APP_ID=6806656867
# Comma-separated DER certificates encoded as base64. Download Apple Root CAs from https://www.apple.com/certificateauthority/
APPLE_ROOT_CA_BASE64=
# Services ID used as the first Apple Client ID in Supabase Auth.
APPLE_SIGN_IN_CLIENT_ID=
APPLE_SIGN_IN_TEAM_ID=
APPLE_SIGN_IN_KEY_ID=
# Base64 of the complete Sign in with Apple AuthKey_XXXXXXXXXX.p8 file.
APPLE_SIGN_IN_PRIVATE_KEY_BASE64=
